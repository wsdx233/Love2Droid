<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editor_search_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceContainer"
    android:elevation="2dp"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/search_expand"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/expand_replace"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="?attr/colorOnSurface" />

        <EditText
            android:id="@+id/search_query"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="@string/search_text_hint"
            android:imeOptions="actionSearch"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_regex"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:contentDescription="@string/use_regular_expression"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/regex_short"
            android:textAllCaps="false"
            android:checkable="true" />

        <ImageButton
            android:id="@+id/search_previous"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous_match"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_up"
            android:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/search_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next_match"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_down"
            android:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/search_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_search"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/search_replace_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <Space
            android:layout_width="40dp"
            android:layout_height="1dp" />

        <EditText
            android:id="@+id/search_replacement"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="@string/replacement_text_hint"
            android:imeOptions="actionDone"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_replace"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:text="@string/replace_current" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_replace_all"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:text="@string/replace_all" />
    </LinearLayout>
</LinearLayout>
