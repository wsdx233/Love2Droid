<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <View
        android:id="@+id/setup_top_inset"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/action_bar_background"
        android:importantForAccessibility="no" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/setup_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/action_bar_background"
        app:title="@string/proot_setup_title"
        app:titleTextColor="@color/action_bar_foreground" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/setup_progress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/setup_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="@string/proot_install_preparing"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="@string/proot_setup_logs"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/setup_log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:background="#101114"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/setup_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/maple_mono_nf_cn_regular"
            android:padding="12dp"
            android:text="@string/proot_setup_logs_empty"
            android:textColor="#D4D4D8"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/setup_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setup_retry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retry"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setup_continue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/proot_enter_editor"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
