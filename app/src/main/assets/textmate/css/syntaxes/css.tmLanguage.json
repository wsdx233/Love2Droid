{
  "name": "CSS",
  "scopeName": "source.css",
  "patterns": [
    { "name": "comment.block.css", "begin": "/\\*", "end": "\\*/" },
    { "name": "entity.name.tag.css", "match": "(?:[#.]?[A-Za-z_][\\w-]*|\\*)\\s*(?=\\{)" },
    { "name": "support.type.property-name.css", "match": "[A-Za-z-]+\\s*(?=:)" },
    { "name": "string.quoted.double.css", "begin": "\\\"", "end": "\\\"" },
    { "name": "string.quoted.single.css", "begin": "'", "end": "'" },
    { "name": "constant.numeric.css", "match": "(?:#?[0-9a-fA-F]{3,8}|-?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|em|rem|%|vh|vw|s|deg)?|0)" },
    { "name": "punctuation.definition.css", "match": "[{}();:,]" }
  ]
}
